# --- Supabase (backend: auth, database, storage) ---
# Public project URL + publishable/anon key. Safe to expose in the browser;
# Row Level Security is what protects the data. From the Supabase dashboard
# (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key (bypasses RLS). NEVER expose to the browser and
# never commit a real value — set it only in .env.local / the host env. The
# money routes (checkout, webhook, refunds, payouts) stay dormant and return a
# 503 "payments_not_configured" until this is set.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute app origin used to build Stripe success/cancel + Connect return URLs
# (e.g. https://skillset.example.com). Falls back to SITE_URL when unset.
SKILLSET_APP_URL=

# --- Video hosting ---
# Bunny Stream is optional: when the library id is set, lesson videos upload
# resumably to Bunny (up to 5GB) and play through signed embeds; when unset,
# video uploads fall back to Supabase Storage and are bound by the limit below.
# Public Bunny Stream library id — appears in every embed URL, safe for the browser.
# NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=
# Server-only API key used to create video objects and sign TUS uploads.
# BUNNY_STREAM_API_KEY=
# Server-only token-auth key used to sign protected embed/playback URLs.
# BUNNY_STREAM_TOKEN_KEY=
# Effective per-file Supabase Storage upload cap in MB. This is the PLAN-level
# global limit (free plan: 50) — it overrides the bucket's 500MB setting, so
# client validation and error copy use it. Defaults to 50 when unset.
NEXT_PUBLIC_SUPABASE_UPLOAD_LIMIT_MB=50

# --- Stripe ---
# Client-side publishable key only. Safe to expose in browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYMENTS_CHECKOUT_ENABLED=false
# Requires a Stripe Mexico platform account and MXN Checkout pricing.
NEXT_PUBLIC_PAYMENTS_CARD_INSTALLMENTS_ENABLED=false

# Server-side Stripe secrets (sk_*, whsec_*). Set only in .env.local / the host
# env, never in client env or the repo. Payments are inert until both are set.
# NOTE: plan subscriptions are charged by Stripe but the plan (and its lower
# commission) is only applied by the webhook — with STRIPE_WEBHOOK_SECRET
# unset or the endpoint unconfigured, paying customers stay on Free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Shared secret for scheduled jobs (sent as `Authorization: Bearer <value>`).
# /api/cron/advisor-knowledge rejects every request until this is set, so nobody
# can trigger a reindex — and burn embedding credit — without it. Vercel Cron
# sends the header automatically; the same header lets the owner run the job by
# hand. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Server-only pepper for the hashed-IP rate-limit keys (HMAC-SHA256 in
# src/lib/supabase/rate-limit.ts). A plain sha256 of an IPv4 is one lookup table
# over four billion candidates away from the visitor's address, so the stored row
# would still be personal data in disguise.
# Unset, the limiter falls back to a pepper drawn per process: still not
# reversible, but every cold start resets the buckets and the server logs one
# error asking for this variable. SET IT IN PRODUCTION.
# Generate with `openssl rand -hex 32`.
RATE_LIMIT_PEPPER=

# --- PostHog product analytics (client-side) ---
# Key from the PostHog project settings; analytics stay disabled when unset.
# Host is optional and defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- AI ---
# Teacher studio advisor (auth-required, /api/teach/advisor). It calls Moonshot
# (kimi-k3) directly, with no n8n hop. See docs/teacher-advisor-setup.md for the
# founder wiring guide.
NEXT_PUBLIC_TEACHER_ADVISOR_ENABLED=false
# Server-only Moonshot (Kimi) key. Unset means the advisor renders a calm
# "being set up" state instead of answering.
KIMI_API_KEY=
# Google Doc the owner edits by hand, mirrored into the advisor's retrieval
# corpus by /api/cron/advisor-knowledge. Must be the plain-text EXPORT url of a
# doc shared as "anyone with the link can view", i.e.
# https://docs.google.com/document/d/<doc-id>/export?format=txt
# Unset means the advisor still answers, just without that extra knowledge.
ADVISOR_KNOWLEDGE_DOC_URL=
# Server-only OpenAI key, used ONLY for embeddings (text-embedding-3-small):
# the sync job embeds the Doc and retrieval embeds the teacher's question with
# the same model. No answer is ever generated by OpenAI. Unset disables
# retrieval, and the sync job reports openai_key_missing.
OPENAI_API_KEY=

# Public help-center assistant, grounded in the /help FAQ (/api/assistant).
# Still n8n-fronted: server-only webhook URL plus a shared secret, degrading to
# a friendly 503 "being set up" when the URL is unset.
N8N_ASSISTANT_WEBHOOK_URL=
N8N_ASSISTANT_WEBHOOK_SECRET=
NEXT_PUBLIC_PLATFORM_ASSISTANT_ENABLED=false

# --- Feature flags ---
# TOTP two-factor (client). Leave false unless the MFA UI is wired.
NEXT_PUBLIC_AUTH_MFA_ENABLED=false
