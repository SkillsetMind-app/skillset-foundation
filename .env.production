# Production NEXT_PUBLIC_* values that are SAFE to ship in the browser bundle.
# NEVER add server secrets here. The real source of truth for production env is
# the Vercel dashboard, which overrides these at build time; this file only
# provides public defaults. Supabase URL/anon key + all server secrets live in
# the Vercel dashboard (see .env.example for the full contract).
#
# PostHog publishable key (project ingest key, prefix phc_) — designed to be
# embedded in client-side bundles. The server-only PROJECT API key is not here.
NEXT_PUBLIC_POSTHOG_KEY=phc_kpptL6yb5Z6wP2Ht2PTynJKEpYLtW3ViAXRJViDAjyhn
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Live course checkout enabled for the investor demo (founder Option B).
# NEXT_PUBLIC_* is build-time public by design; this is a boolean flag, not a secret.
NEXT_PUBLIC_PAYMENTS_CHECKOUT_ENABLED=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51TUqjLPvg1vJW0Ijv82VKQF08GIhSmXPqz7QYkaHErxbo9KnTJnvTDvf7lYFKO9pkOiWOXejKozo6xnEonKZaLi300rrddSduO
